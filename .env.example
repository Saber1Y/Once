# Copy to .env and fill in. Never commit .env.

# neatlogs SDK project key (app.neatlogs.com -> project settings)
NEATLOGS_API_KEY=

# Optional: neatlogs Public API service token (observability:read) for trace readback
NEATLOGS_TOKEN=
NEATLOGS_PROJECT_ID=
NEATLOGS_APP_URL=https://app.neatlogs.com

# neatHack LiteLLM proxy (OpenAI-compatible)
LLM_BASE_URL=
LLM_API_KEY=
# Model for the support agent and for the cheap tier-2 judge
ONCE_MODEL=
ONCE_JUDGE_MODEL=
